{{- $.Scratch.Add "index" slice -}}
{{- range site.RegularPages -}}
    {{- if and (not .Params.searchHidden) (ne .Layout `archives`) (ne .Layout `search`) }}
    {{- $.Scratch.Add "index" (dict "title" .Title "content" .Plain "permalink" .Permalink "summary" .Summary) -}}
    {{- end }}
{{- end -}}

{{- /* 同时索引嵌套 section 页面(如 AI与数学、数学文化、代数表示论) */ -}}
{{- range site.Pages -}}
    {{- if and (eq .Kind "section") (not .Parent.IsHome) (not .Params.searchHidden) }}
    {{- /* AI与数学 专题在首页圆盘显示为 "AI",搜索结果标题保持一致 */ -}}
    {{- $sectionTitle := .Title -}}
    {{- if eq .Title "AI 与数学" }}
        {{- $sectionTitle = "AI" -}}
    {{- end -}}
    {{- $.Scratch.Add "index" (dict "title" $sectionTitle "content" .Plain "permalink" .Permalink "summary" .Summary) -}}
    {{- end }}
{{- end -}}

{{- /* 解析 AI 与数学大事记中的具体条目，作为独立搜索项 */ -}}
{{- $aimath := site.GetPage "posts/aimath" -}}
{{- if $aimath -}}
    {{- $content := $aimath.Content -}}
    {{- $anchor := "#ai-panel-timeline" -}}
    {{- $permalink := print $aimath.Permalink $anchor -}}

    {{- /* findRE 不能返回捕获组，用 replaceRE 提取年份/标题/描述 */ -}}
    {{- $lis := findRE `<li><span class="ai-year">\d{4}</span>｜.*?</li>` $content -}}
    {{- range $lis -}}
        {{- $year := replaceRE `.*?<span class="ai-year">(\d{4})</span>｜.*` "$1" . -}}
        {{- /* 标题和描述以“｜年份”开头，以“：”或</li>分隔；部分条目没有“：” */ -}}
        {{- $rest := replaceRE `.*?<span class="ai-year">\d{4}</span>｜(.*)` "$1" . -}}
        {{- $titleHTML := replaceRE `^(.*?)：.*$` "$1" $rest -}}
        {{- $descHTML := replaceRE `^.*?：(.*?)</li>$` "$1" $rest -}}
        {{- /* 如果没有冒号，则标题取全部，描述为空 */ -}}
        {{- if eq $titleHTML $rest -}}
            {{- $titleHTML = replaceRE `^(.*?)</li>$` "$1" $rest -}}
            {{- $descHTML = "" -}}
        {{- end -}}
        {{- $titleText := $titleHTML | plainify | htmlUnescape | chomp -}}
        {{- $descText := $descHTML | plainify | htmlUnescape | chomp -}}
        {{- if $titleText -}}
            {{- $entryTitle := printf "%s｜%s" $year $titleText -}}
            {{- $.Scratch.Add "index" (dict "title" $entryTitle "content" $descText "permalink" $permalink "summary" $descText) -}}
        {{- end -}}
    {{- end -}}
{{- end -}}

{{- /* 解析“代数表示论”各猜想面板为独立搜索项，permalink 带 #ar-panel-xxx 锚点 */ -}}
{{- $ar := site.GetPage "posts/代数表示论" -}}
{{- if $ar -}}
    {{- $panelKeys := slice "finite" "nakayama" "gorenstein" "wakamatsu" "cartan" "broue" "telescope" "brauerthrall" "gpc" "nlc" "igusasmalo" "extension" "hpr" "gpfdc" "fcy" "ncluster" "gentle" "garc" "silting" "derivedsimple" "ttgeom" -}}
    {{- range $panelKeys -}}
        {{- $p := site.GetPage (printf "posts/代数表示论/panels/%s" .) -}}
        {{- if $p -}}
            {{- $permalink := print $ar.Permalink "#ar-panel-" . -}}
            {{- $.Scratch.Add "index" (dict "title" $p.Title "content" $p.Plain "permalink" $permalink "summary" $p.Summary) -}}
        {{- end -}}
    {{- end -}}
{{- end -}}

{{- $.Scratch.Get "index" | jsonify -}}
